# ===========================================
# Social Media Scraper - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.

# --- YouTube ---
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_QUERIES=
YOUTUBE_MAX_RESULTS=10

# --- Twitter / X ---
# The bearer token is forwarded to webscraping.ai, a third-party proxy.
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERIES=
TWITTER_TWEET_COUNT=100
WEBSCRAPING_AI_KEY=

# --- Instagram ---
INSTAGRAM_TARGETS=
INSTAGRAM_PROXY=

# --- Scheduler ---
SCRAPE_INTERVAL_MINUTES=60

# --- Browser ---
HEADLESS=true
# Opt in only if your environment requires disabling Chrome's security sandbox.
CHROME_NO_SANDBOX=false

# --- Export ---
EXPORT_FORMAT=json
